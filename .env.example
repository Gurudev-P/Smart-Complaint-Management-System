# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://scms:scms@localhost:5432/scms

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# First administrator (created on startup only if no administrator exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
ADMIN_NAME=System Administrator

# Business rules
STAFF_CAN_ASSIGN=true
SLA_CHECK_INTERVAL_SECONDS=60
ENABLE_SCHEDULER=true
